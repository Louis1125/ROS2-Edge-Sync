#!/usr/bin/env bash
# ROS2-Edge-Sync unified entry point: up / down / status / doctor.
#   ./edge-sync up [--mode local|edge|production]
#   ./edge-sync down [--mode ...]    (preserves data unless --reset)
#   ./edge-sync status [--mode ...]
#   ./edge-sync doctor [--mode ...]
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODE=local
CMD=help
RESET=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode) MODE="$2"; shift 2 ;;
    --reset) RESET=1; shift ;;
    up|down|status|doctor|help|version) CMD="$1"; shift ;;
    *) echo "error: unknown argument '$1'"; exit 2 ;;
  esac
done

case "$MODE" in
  local|edge|production) : ;;
  *) echo "error: --mode must be local|edge|production"; exit 2 ;;
esac

log()  { echo "[edge-sync] $*"; }
die()  { echo "error: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }

# --- local (Docker) backend ---
local_images() {
  docker image inspect edge-sync-drogon-base >/dev/null 2>&1 || \
    docker build -f docker/drogon-base.Dockerfile -t edge-sync-drogon-base "$ROOT"
  docker image inspect edge-sync-cp-runtime >/dev/null 2>&1 || \
    docker build -f docker/control-plane.Dockerfile -t edge-sync-cp-runtime "$ROOT"
}

local_up() {
  need docker
  local_images
  docker network create edge-sync-net 2>/dev/null || true
  docker rm -f edge-sync-pg edge-sync-cp edge-sync-web 2>/dev/null || true

  docker run -d --name edge-sync-pg --network edge-sync-net \
    -e POSTGRES_DB=edge_sync -e POSTGRES_USER=edge_sync \
    -e POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-edge_sync}" \
    -v edge-sync-pgdata:/var/lib/postgresql/data postgres:16-alpine >/dev/null

  # control plane: needs the built data-plane + control-plane binaries
  local_build
  docker run -d --name edge-sync-cp --network edge-sync-net -p 8080:8080 \
    --entrypoint /bin/bash -v "$ROOT":/workspace edge-sync-cp-runtime -c '
      export LD_LIBRARY_PATH=/opt/drogon/lib:/workspace/install/edge_sync_base/lib:/workspace/install/edge_sync_core/lib:/workspace/install/edge_sync_protocol/lib:/workspace/install/edge_sync_connection/lib:/workspace/install/edge_sync_connection_asio/lib:$LD_LIBRARY_PATH
      export MIGRATIONS_DIR=/workspace/apps/edge_sync_control_plane/migrations
      export DATABASE_URL="host=edge-sync-pg port=5432 dbname=edge_sync user=edge_sync password='"${POSTGRES_PASSWORD:-edge_sync}"'"
      export EDGE_SYNC_FLEET_SECRET="'"${EDGE_SYNC_FLEET_SECRET:-change-me}"'"
      exec /workspace/build/control/edge_sync_control_plane' >/dev/null

  # frontend (Vite dev server proxying /api to the control plane)
  docker run -d --name edge-sync-web --network edge-sync-net -p 5173:5173 \
    -v "$ROOT/web":/app -w /app node:20-alpine \
    sh -c 'npm install >/dev/null 2>&1 && npx vite --host --port 5173' >/dev/null

  # wait for control-plane health
  for i in $(seq 1 30); do
    curl -fsS http://localhost:8080/api/v1/health >/dev/null 2>&1 && break
    sleep 1
  done
  curl -fsS http://localhost:8080/api/v1/health >/dev/null 2>&1 || die "control plane did not become healthy"

  log "control plane: http://localhost:8080  (health: ok)"
  log "web console:   http://localhost:5173"
  log "enroll a robot: run the robot daemon with control_plane.host/port set (see COMMANDS.md)"
}

local_build() {
  if [ ! -f "$ROOT/install/edge_sync_runtime/bin/edge_syncd" ] || [ ! -f "$ROOT/build/control/edge_sync_control_plane" ]; then
    log "building C++ packages (first time)…"
    docker run --rm -v "$ROOT":/workspace -w /workspace \
      engineai_robotics_env:humble-desktop-local bash -c \
      'source /opt/ros/humble/setup.bash && colcon build' >/dev/null
    docker run --rm --entrypoint /bin/bash -v "$ROOT":/workspace -w /workspace edge-sync-cp-runtime -c \
      'cmake -B build/control -S apps/edge_sync_control_plane -DCMAKE_PREFIX_PATH="/opt/drogon;/workspace/install/edge_sync_base;/workspace/install/edge_sync_core;/workspace/install/edge_sync_protocol;/workspace/install/edge_sync_connection;/workspace/install/edge_sync_connection_asio" -DCMAKE_BUILD_TYPE=Release >/dev/null 2>&1 && cmake --build build/control -j2' >/dev/null
  fi
}

local_down() {
  need docker
  docker rm -f edge-sync-pg edge-sync-cp edge-sync-web 2>/dev/null || true
  if [ "$RESET" = "1" ]; then
    docker volume rm edge-sync-pgdata 2>/dev/null || true
    log "stopped and removed persistent data (--reset)"
  else
    log "stopped; PostgreSQL data preserved (use --reset to delete)"
  fi
}

local_status() {
  need docker
  docker ps --filter name=edge-sync- --format 'table {{.Names}}\t{{.Status}}'
  echo "--- control plane ---"
  curl -s http://localhost:8080/api/v1/health || echo "(unreachable)"
  echo
  echo "--- robots ---"
  curl -s http://localhost:8080/api/v1/robots || echo "(unreachable)"
  echo
  echo "--- sync jobs ---"
  curl -s http://localhost:8080/api/v1/sync-jobs || echo "(unreachable)"
  echo
}

local_doctor() {
  need docker
  docker info >/dev/null 2>&1 || die "Docker daemon is not running"
  echo "OK   docker"
  docker image inspect edge-sync-cp-runtime >/dev/null 2>&1 && echo "OK   control-plane image" || echo "WARN control-plane image missing (run: ./edge-sync up)"
  docker image inspect postgres:16-alpine >/dev/null 2>&1 && echo "OK   postgres image" || echo "WARN postgres image missing (will pull on up)"
  if curl -fsS http://localhost:8080/api/v1/health >/dev/null 2>&1; then echo "OK   control plane healthy"; else echo "WARN control plane not running (run: ./edge-sync up)"; fi
  if [ -f "$ROOT/install/edge_sync_runtime/bin/edge_syncd" ]; then echo "OK   data-plane build present"; else echo "WARN data-plane not built (run: ./edge-sync up)"; fi
}

# --- k3s backend (delegates to scripts/k3s) ---
k3s_delegate() {
  local op="$1"
  case "$op" in
    up) bash "$ROOT/scripts/k3s/install.sh" "$MODE" ;;
    down) bash "$ROOT/scripts/k3s/uninstall.sh" ;;
    status) bash "$ROOT/scripts/k3s/status.sh" ;;
    doctor) bash "$ROOT/scripts/k3s/doctor.sh" ;;
  esac
}

help_text() {
  cat <<EOF
ROS2-Edge-Sync — unified entry point

Usage: ./edge-sync <command> [--mode local|edge|production]

Commands:
  up       start the platform (build/pull images, migrate, wait for health)
  down     stop cleanly (preserves data unless --reset)
  status   show mode, service health, database, gateway, robots, jobs
  doctor   diagnose the environment with corrective suggestions

Modes:
  local       Docker Compose-style local deployment (default)
  edge        single K3s edge server via Helm
  production  Kubernetes deployment with external PostgreSQL + TLS (Helm)

Examples:
  ./edge-sync up --mode local
  ./edge-sync status
  ./edge-sync doctor --mode edge
  ./edge-sync down --mode local --reset
EOF
}

case "$CMD" in
  up)
    if [ "$MODE" = local ]; then local_up; else k3s_delegate up; fi ;;
  down)
    if [ "$MODE" = local ]; then local_down; else k3s_delegate down; fi ;;
  status)
    if [ "$MODE" = local ]; then local_status; else k3s_delegate status; fi ;;
  doctor)
    if [ "$MODE" = local ]; then local_doctor; else k3s_delegate doctor; fi ;;
  help|*) help_text ;;
esac
