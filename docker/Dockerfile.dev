ARG ROS_DISTRO=humble
FROM osrf/ros:${ROS_DISTRO}-desktop

# C++ toolchain + project dependencies (Boost.Asio header-only, protobuf, SQLite, GTest).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    cmake \
    python3-colcon-common-extensions \
    libboost-system-dev \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    libsqlite3-dev \
    libgtest-dev \
    clang-format \
    clang-tidy \
    gdb \
    valgrind \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["/bin/bash"]
