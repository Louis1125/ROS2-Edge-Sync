<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>edge_sync_connection</name>
  <version>0.1.0</version>
  <description>Connection Foundation: peer/session management and handshaking, plus the Asio TCP transport as a separate internal target.</description>
  <maintainer email="you@example.com">ROS2-Edge-Sync Contributors</maintainer>
  <license>MIT</license>

  <depend>edge_sync_base</depend>
  <depend>edge_sync_protocol</depend>
  <depend>edge_sync_core</depend>
  <depend>libboost-system-dev</depend>

  <test_depend>gtest_vendor</test_depend>
  <test_depend>edge_sync_storage</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
